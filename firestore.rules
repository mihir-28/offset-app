rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /cards/{cardId} {
      allow create: if ownsNew();
      allow read: if ownsExisting();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    match /transactions/{transactionId} {
      allow create: if ownsNew();
      allow read: if ownsExisting();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    match /statementCycles/{cycleId} {
      allow create: if ownsNew();
      allow read: if ownsExisting();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
      allow delete: if ownsExisting();
    }
  }
}
